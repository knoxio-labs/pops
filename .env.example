# Copy to .env and fill in values. NEVER commit .env.
# In production, runtime secrets are written to ./secrets/<name> files and
# mounted into containers via Docker file-based secrets (see infra/docker-compose.yml).
# Server-side provisioning + ansible vault live in knoxio/homelab-infra.

# Up Bank
UP_BANK_TOKEN=
UP_WEBHOOK_SECRET=

# Claude AI
CLAUDE_API_KEY=

# Telegram (Moltbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Finance API
FINANCE_API_KEY=

# Public base domain (used by paperless-ngx for callback URLs).
POPS_DOMAIN=

# Media Metadata Providers
# TMDB: Get a Read-Access Token (v4 auth) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# TheTVDB: Get an API Key from https://thetvdb.com/dashboard/account/apikey
THETVDB_API_KEY=

# Plex Media Server (optional — library sync)
PLEX_URL=
PLEX_TOKEN=

# Paperless-ngx (optional — document management)
PAPERLESS_BASE_URL=
PAPERLESS_API_TOKEN=

# Paths
# Each pillar owns its OWN SQLite file — there is no shared monolith DB.
# A pillar resolves its path from its dedicated <PILLAR>_SQLITE_PATH env var,
# falling back to `<dirname(SQLITE_PATH)>/<pillar>.db`, then to
# `./data/<pillar>.db`. Set SQLITE_PATH only as a shared base directory hint;
# override an individual pillar with its own var when you need a custom path.
#   SQLITE_PATH=./data/pops.db   # shared base dir; pillars derive <pillar>.db next to it
CORE_SQLITE_PATH=./data/core.db
INVENTORY_SQLITE_PATH=./data/inventory.db
MEDIA_SQLITE_PATH=./data/media.db
FINANCE_SQLITE_PATH=./data/finance.db
FOOD_SQLITE_PATH=./data/food.db
LISTS_SQLITE_PATH=./data/lists.db
CEREBRUM_SQLITE_PATH=./data/cerebrum.db
# Cerebrum engram root (Markdown files on disk). Absolute path recommended —
# the pillar writes here (reclassify, link edits, reflexes.toml), so a relative
# path resolves under the container's root-owned /app and fails with EACCES.
CEREBRUM_ENGRAMS_DIR=./data/engrams

# Image rollout
# Pin a specific tag to disable Watchtower auto-updates. Options:
#   POPS_IMAGE_TAG=main          # latest from main branch (default)
#   POPS_IMAGE_TAG=v0.1.0        # exact semver release (most stable)
#   POPS_IMAGE_TAG=v0.1          # latest patch within a minor line
#   POPS_IMAGE_TAG=v0            # latest minor within a major line
#   POPS_IMAGE_TAG=sha-abc1234   # exact build, no auto-rollout ever
# Applies to every published pops image: the per-pillar APIs
# (ghcr.io/knoxio/pops-<pillar>), the cerebrum worker (shares the cerebrum
# image), the orchestrator, and pops-shell. See docs/runbooks/cut-release.md
# for the release flow.
POPS_IMAGE_TAG=main

# Watchtower
# Docker API version Watchtower negotiates with the host daemon. 1.45 works for
# any Docker ≥ 24 (the default daemon is fine). Drop to 1.40 if your host runs
# something older — Watchtower 1.7.1's built-in default of 1.24 is too old for
# modern daemons (they reject anything below 1.40).
DOCKER_API_VERSION=1.45

# Host docker config dir, used by Watchtower to pull from private GHCR if your
# images are private. Pops's published images are public, so the default value
# is fine unless you're hosting a private fork.
DOCKER_CONFIG_DIR=/root/.docker

TZ=Australia/Melbourne

# BFM (Backend-for-Mobile) operator surface
# bfm answers on TWO hostnames and only one is behind Cloudflare Access. Its
# own tunnel hostname has Access BYPASSED so the iPhone can pair without a
# session (POPS-1389), and the same Express app answers there. That is why bfm
# alone in the fleet must NOT fall back to trusting the tunnel when no Access
# team is configured: on a bypassed hostname that would resolve every caller on
# the internet to an operator.
#
# The consequence: leave these empty and the /operator routes refuse EVERYONE,
# including you. That fails closed rather than open, but the Devices page stays
# dark until they are set. Provisioning is POPS-1475.

# Cloudflare Zero Trust team name — the subdomain in
# <team>.cloudflareaccess.com, which is where the JWT signing keys are fetched.
CLOUDFLARE_ACCESS_TEAM_NAME=

# The Access application's AUD tag. Access mints one JWT per application off
# the SAME team keys, so without this a token issued for any other protected
# app on the team verifies here too. Set it whenever the team hosts more than
# one application.
CLOUDFLARE_ACCESS_AUD=

# The public origin the PHONE dials — bfm's Access-bypassed tunnel hostname,
# e.g. https://bfm.example.com. It is baked into the pairing QR, so an empty
# value yields a code that scans cleanly and then goes nowhere: it falls back
# to the in-cluster http://bfm-api:3014, which no handset can resolve.
BFM_PUBLIC_BASE_URL=

# Design playground comments
# The overlay in the design playground (`pillars/design`) writes comment
# threads to `design-api`. By default it needs none of this: run
# `pnpm --filter @pops/design dev:all` (or `mise run dev:all` from that
# directory) to start the playground and a local `design-api` together, and
# the dev proxy and `scripts/design-feedback-mcp.mjs` both fall back to that
# local API with no credentials at all — it trusts any caller outside
# production.
#
# These three are only for reaching a DEPLOYED API from this machine instead:
# the Vite dev proxy attaches them so the browser never sees the credential,
# and `scripts/design-feedback-mcp.mjs` uses the same pair so a session reads
# the same threads.

# The deployed API's origin, e.g. https://pops.example.com/design-api
POPS_DESIGN_FEEDBACK_URL=

# Cloudflare Zero Trust → Access → Service Tokens → Create Service Token.
# The token's JWT carries `common_name` and no email, which is why the pillar
# admits service principals as well as human sessions.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
