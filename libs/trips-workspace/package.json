{
  "name": "@pops/trips-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./decision-client": "./src/decision/client.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "node ../../scripts/require-built-graph.mjs && tsc --noEmit",
    "test": "node ../../scripts/require-built-graph.mjs && vitest run",
    "generate:trips-client": "openapi-ts -o src/trips-api",
    "generate:documents-client": "openapi-ts -f openapi-ts.documents.config.ts -o src/documents-api"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
