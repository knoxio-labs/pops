{
  "name": "@pops/pillar-sdk",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist/**"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest-schema": {
      "types": "./dist/manifest-schema/index.d.ts",
      "default": "./dist/manifest-schema/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap/index.d.ts",
      "default": "./dist/bootstrap/index.js"
    },
    "./pillar-env": {
      "types": "./dist/pillar-env/index.d.ts",
      "default": "./dist/pillar-env/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "default": "./dist/access/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "default": "./dist/discovery/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "default": "./dist/capabilities/index.js"
    },
    "./ai-tools": {
      "types": "./dist/ai-tools/index.d.ts",
      "default": "./dist/ai-tools/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./remote-build": {
      "types": "./dist/remote-build/index.d.ts",
      "default": "./dist/remote-build/index.js"
    },
    "./ranking": {
      "types": "./dist/ranking/index.d.ts",
      "default": "./dist/ranking/index.js"
    },
    "./orchestrator": {
      "types": "./dist/orchestrator/index.d.ts",
      "default": "./dist/orchestrator/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "node ../../scripts/require-built-graph.mjs && tsc --noEmit",
    "test": "node ../../scripts/require-built-graph.mjs && vitest run",
    "test:coverage": "node ../../scripts/require-built-graph.mjs && vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pops/types": "workspace:*",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.101.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.0",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/vite": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
