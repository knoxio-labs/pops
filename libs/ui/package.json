{
  "name": "@pops/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": {
      "types": "./src/theme/globals.d.ts",
      "default": "./src/theme/index.css"
    },
    "./theme/globals.css": "./src/theme/globals.css",
    "./theme/graph-colors": "./src/theme/graph-colors.ts",
    "./theme/chart-colors": "./src/theme/chart-colors.ts",
    "./testing/decode-qr": "./src/testing/decode-qr.ts"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "node ../../scripts/require-built-graph.mjs && vitest run && node scripts/check-storybook-coverage.mjs",
    "test:coverage": "node ../../scripts/require-built-graph.mjs && vitest run --coverage && node scripts/check-storybook-coverage.mjs",
    "typecheck": "node ../../scripts/require-built-graph.mjs && tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json"
  },
