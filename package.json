{
  "name": "@pops/monorepo",
  "private": true,
  "scripts": {
    "dev": "mise run dev",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "mise run typecheck",
    "test": "mise run test",
    "test:coverage": "mise run test:coverage",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs --ignore-known --output-type err pillars libs scripts",
    "lint:boundaries:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json pillars libs scripts",
    "extractability:deps": "bash scripts/extractability/check-changed-units.sh",
    "extractability:deps:all": "node scripts/extractability/depcheck.mjs --all",
    "extractability:deps:self-test": "node scripts/extractability/depcheck.mjs --self-test",
    "extractability:baseline": "bash scripts/extractability/baseline-guard.sh",
    "extractability:sandbox": "bash scripts/extractability/sandbox.sh",
    "isolation:check": "pnpm lint:boundaries && pnpm extractability:baseline && pnpm extractability:deps && bash scripts/extractability/optional-gates.sh",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "exports:check": "node scripts/check-exports.mjs",
    "check:bundle-map": "node scripts/check-bundle-map-coverage.mjs",
    "check:bundle-map:self-test": "node scripts/check-bundle-map-coverage.mjs --self-test",
    "check:tailwind-source": "node scripts/check-tailwind-source-coverage.mjs",
    "check:tailwind-source:self-test": "node scripts/check-tailwind-source-coverage.mjs --self-test",
    "check:vendored-contracts": "node scripts/ci/check-vendored-contracts.mjs",
    "check:vendored-contracts:self-test": "node scripts/ci/check-vendored-contracts.mjs --self-test",
    "check:device-signature": "node scripts/ci/check-device-signature-fixture.mjs",
    "check:device-signature:self-test": "node scripts/ci/check-device-signature-fixture.mjs --self-test",
    "check:refresh-message": "node scripts/ci/check-refresh-message-fixture.mjs",
    "check:refresh-message:self-test": "node scripts/ci/check-refresh-message-fixture.mjs --self-test",
    "check:escape-hatches": "node scripts/check-escape-hatches.mjs",
    "check:escape-hatches:self-test": "node scripts/check-escape-hatches.mjs --self-test",
    "check:escape-hatches:baseline": "node scripts/check-escape-hatches.mjs --write",
    "check:control-characters": "node scripts/ci/check-control-characters.mjs",
    "check:control-characters:self-test": "node scripts/ci/check-control-characters.mjs --self-test",
    "ci:fix": "pnpm lint:fix && pnpm format && pnpm typecheck",
    "registry:build": "pnpm --filter @pops/module-registry registry:build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "dependency-cruiser": "^17.4.3",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^0.23.0",
    "smol-toml": "^1.7.1",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.20.0"
}
