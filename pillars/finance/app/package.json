{
  "name": "@pops/app-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm run build:remote",
    "build:remote": "tsx scripts/build-remote.ts",
    "dev:standalone": "vite --config vite.standalone.config.ts",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "typecheck": "node ../../../scripts/require-built-graph.mjs && tsc --noEmit",
    "test": "node ../../../scripts/require-built-graph.mjs && vitest run",
    "test:coverage": "node ../../../scripts/require-built-graph.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "generate:finance-client": "openapi-ts -o src/finance-api",
    "generate:contacts-client": "openapi-ts -f openapi-ts.contacts.config.ts -o src/contacts-api",
    "generate:purchases-client": "openapi-ts -f openapi-ts.purchases.config.ts -o src/purchases-api"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hey-api/client-fetch": "^0.13.1",
    "@hookform/resolvers": "^5.9.1",
    "@pops/date": "workspace:*",
    "@pops/finance": "workspace:*",
    "@pops/navigation": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.71.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.0.13",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.11"
  }
}
