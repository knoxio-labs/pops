{
  "name": "@pops/app-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./design": "./src/design.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "generate:finance-client": "openapi-ts && oxfmt --write src/finance-api",
    "generate:contacts-client": "openapi-ts -f openapi-ts.contacts.config.ts && oxfmt --write src/contacts-api",
    "generate:purchases-client": "openapi-ts -f openapi-ts.purchases.config.ts && oxfmt --write src/purchases-api"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hey-api/client-fetch": "^0.13.1",
    "@hookform/resolvers": "^5.9.1",
    "@pops/finance": "workspace:*",
    "@pops/navigation": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.0",
    "lucide-react": "^1.38.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@pops/locales": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
