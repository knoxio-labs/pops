{
  "components": {
    "schemas": {
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "details": {},
          "message": {
            "type": "string"
          },
          "requestId": {
            "minLength": 1,
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": ["code", "message", "requestId", "retryable"],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "OpenAPI projection of the documents pillar's REST contract. Authored as a ts-rest contract (src/contract/rest.ts); consumed by the pillar SDK to build its operationId route map.",
    "title": "@pops/documents",
    "version": "0.1.0"
  },
  "openapi": "3.0.2",
  "paths": {
    "/paperless/documents/{id}": {
      "get": {
        "operationId": "paperless.get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "exclusiveMinimum": true,
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "additionalProperties": false,
                      "properties": {
                        "created": {
                          "type": "string"
                        },
                        "id": {
                          "type": "number"
                        },
                        "originalFileName": {
                          "type": "string"
                        },
                        "thumbnailUrl": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        }
                      },
                      "required": ["id", "title", "created", "originalFileName", "thumbnailUrl"],
                      "type": "object"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": "200"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "404"
          },
          "412": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "412"
          }
        },
        "summary": "Resolve one Paperless-ngx document by id (404 when it no longer exists)",
        "tags": ["paperless"]
      }
    },
    "/paperless/search": {
      "get": {
        "operationId": "paperless.search",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 2,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "created": {
                            "type": "string"
                          },
                          "id": {
                            "type": "number"
                          },
                          "originalFileName": {
                            "type": "string"
                          },
                          "thumbnailUrl": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          }
                        },
                        "required": ["id", "title", "created", "originalFileName", "thumbnailUrl"],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": "200"
          },
          "412": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "412"
          }
        },
        "summary": "Search Paperless-ngx documents (412 if not configured)",
        "tags": ["paperless"]
      }
    },
    "/paperless/status": {
      "get": {
        "operationId": "paperless.status",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "additionalProperties": false,
                      "properties": {
                        "available": {
                          "type": "boolean"
                        },
                        "baseUrl": {
                          "nullable": true,
                          "type": "string"
                        },
                        "configured": {
                          "type": "boolean"
                        },
                        "documentCount": {
                          "maximum": 9007199254740991,
                          "minimum": 0,
                          "nullable": true,
                          "type": "integer"
                        }
                      },
                      "required": ["configured", "available", "baseUrl", "documentCount"],
                      "type": "object"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": "200"
          }
        },
        "summary": "Whether Paperless-ngx is configured and reachable",
        "tags": ["paperless"]
      }
    }
  }
}
