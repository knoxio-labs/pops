{
  "name": "@pops/app-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm run build:remote",
    "build:remote": "tsx scripts/build-remote.ts",
    "test": "node ../../../scripts/require-built-graph.mjs && vitest run",
    "test:coverage": "node ../../../scripts/require-built-graph.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "node ../../../scripts/require-built-graph.mjs && tsc --noEmit",
    "generate:inventory-client": "openapi-ts && oxfmt --write src/inventory-api"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hey-api/client-fetch": "^0.13.1",
    "@pops/inventory": "workspace:*",
    "@pops/navigation": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "^8.21.3",
    "browser-image-compression": "^2.0.2",
    "d3-force": "^3.0.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@pops/locales": "workspace:*",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "i18next": "^26.4.2",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
