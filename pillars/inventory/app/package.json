{
  "name": "@pops/app-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./design": "./src/design.ts"
  },
  "scripts": {
    "build": "pnpm run build:remote",
    "build:remote": "tsx scripts/build-remote.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "test -e node_modules/@pops/inventory/dist/contract/index.d.ts || (echo '@pops/inventory has not been built. This app imports its compiled output; run pnpm --filter @pops/inventory build first, then typecheck again. mise run typecheck builds the whole graph before checking any unit and never hits this. See POPS-3072.' >&2 && exit 1) && tsc --noEmit",
    "generate:inventory-client": "openapi-ts && oxfmt --write src/inventory-api"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hey-api/client-fetch": "^0.13.1",
    "@pops/inventory": "workspace:*",
    "@pops/navigation": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "browser-image-compression": "^2.0.2",
    "d3-force": "^3.0.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@pops/locales": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "i18next": "^26.4.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
