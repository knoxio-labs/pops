{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/api/**/*", "src/db/**/*"],
  "exclude": ["**/__tests__/**", "**/*.test.ts", "node_modules", "dist"],
  "references": [
    {
      "path": "../../libs/sdk/tsconfig.build.json"
    }
  ]
}
