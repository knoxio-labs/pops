    "@pops/pillar-sdk": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.10.0",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
