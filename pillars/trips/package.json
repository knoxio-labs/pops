{
  "name": "@pops/trips",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist/contract/**",
    "openapi/trips.openapi.json"
  ],
  "type": "module",
  "exports": {
    "./openapi": "./openapi/trips.openapi.json",
    "./package.json": "./package.json",
    "./pages": {
      "types": "./dist/contract/pages.d.ts",
      "default": "./dist/contract/pages.js"
    },
    "./nav": {
      "types": "./dist/contract/nav.d.ts",
      "default": "./dist/contract/nav.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsx scripts/generate-openapi.ts",
    "dev": "tsx watch --clear-screen=false src/api/server.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "start": "node dist/api/server.js",
    "test": "node ../../scripts/require-built-graph.mjs && vitest run",
    "test:coverage": "node ../../scripts/require-built-graph.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "node ../../scripts/require-built-graph.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@pops/pillar-express": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/express": "3.53.0-rc.1",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pops/contract-openapi": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
