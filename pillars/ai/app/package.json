{
  "name": "@pops/app-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./design": "./src/design.ts"
  },
  "scripts": {
    "build": "pnpm run build:remote",
    "build:remote": "tsx scripts/build-remote.ts",
    "typecheck": "node ../../../scripts/require-built-graph.mjs && tsc --noEmit",
    "test": "node ../../../scripts/require-built-graph.mjs && vitest run",
    "test:coverage": "node ../../../scripts/require-built-graph.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "generate:api": "openapi-ts && oxfmt --write src/ai-api"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hookform/resolvers": "^5.9.1",
    "@pops/ai": "workspace:*",
    "@pops/navigation": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-table": "8.21.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@pops/locales": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.1.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
