{
  "manifest_version": 3,
  "name": "POPS — Everyday Rewards receipt export",
  "version": "0.1.0",
  "description": "Exports Woolworths Everyday Rewards receipts as JSON for the POPS purchases pillar. Read-only; nothing leaves the browser except the file you save.",
  "permissions": ["downloads", "scripting", "tabs"],
  "host_permissions": ["https://www.everyday.com.au/*", "https://apigee-prod.api-wr.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.everyday.com.au/*"],
      "js": ["observe.js", "capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Everyday Rewards receipts"
  }
}
