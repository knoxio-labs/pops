{
  "name": "@pops/purchases",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist/contract/**",
    "openapi/purchases.openapi.json"
  ],
  "type": "module",
  "main": "./dist/contract/index.js",
  "types": "./dist/contract/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./manifest": {
      "types": "./dist/contract/manifest.d.ts",
      "default": "./dist/contract/manifest.js"
    },
    "./api-types": {
      "types": "./dist/contract/api-types.generated.d.ts",
      "default": "./dist/contract/api-types.generated.js"
    },
    "./openapi": "./openapi/purchases.openapi.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx scripts/verify-manifest.ts && tsc -b tsconfig.build.json && tsx scripts/generate-openapi.ts && tsx scripts/generate-api-types.ts",
    "dev": "tsx watch --clear-screen=false src/api/server.ts",
    "generate:api-types": "tsx scripts/generate-api-types.ts",
    "generate:manifest": "tsx scripts/generate-manifest.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "ingest:amazon": "tsx scripts/ingest-amazon.ts",
    "ingest:amazon-digital": "tsx scripts/ingest-amazon-digital.ts",
    "ingest:woolworths": "tsx scripts/ingest-woolworths.ts",
    "propose:kinds": "tsx scripts/propose-kinds.ts",
    "propose:products": "tsx scripts/propose-products.ts",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "verify:manifest": "tsx scripts/verify-manifest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@pops/ai-telemetry": "workspace:*",
    "@pops/pillar-express": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/express": "3.53.0-rc.1",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "papaparse": "^5.6.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pops/contract-openapi": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.4",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
