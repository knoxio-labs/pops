{
  "info": {
    "description": "OpenAPI projection of the barcode pillar's REST contract. Authored as a ts-rest contract and consumed by the pillar SDK for operationId route discovery.",
    "title": "@pops/barcode",
    "version": "0.1.0"
  },
  "openapi": "3.0.2",
  "paths": {
    "/lookup/{code}": {
      "get": {
        "operationId": "lookup.get",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "outcome": {
                          "enum": ["found"],
                          "type": "string"
                        },
                        "product": {
                          "additionalProperties": false,
                          "properties": {
                            "attributes": {
                              "additionalProperties": {
                                "type": "string"
                              },
                              "type": "object"
                            },
                            "code": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "contributors": {
                              "items": {
                                "additionalProperties": false,
                                "properties": {
                                  "name": {
                                    "minLength": 1,
                                    "type": "string"
                                  },
                                  "role": {
                                    "minLength": 1,
                                    "type": "string"
                                  }
                                },
                                "required": ["name"],
                                "type": "object"
                              },
                              "type": "array"
                            },
                            "description": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "fetchedAt": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "imageUrls": {
                              "items": {
                                "format": "uri",
                                "type": "string"
                              },
                              "type": "array"
                            },
                            "kind": {
                              "enum": ["book"],
                              "type": "string"
                            },
                            "language": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "pageCount": {
                              "exclusiveMinimum": true,
                              "maximum": 9007199254740991,
                              "minimum": 0,
                              "type": "integer"
                            },
                            "publishedDate": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "publisher": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "source": {
                              "enum": ["open_library", "google_books"],
                              "type": "string"
                            },
                            "subjects": {
                              "items": {
                                "type": "string"
                              },
                              "type": "array"
                            },
                            "subtitle": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "title": {
                              "minLength": 1,
                              "type": "string"
                            }
                          },
                          "required": [
                            "code",
                            "kind",
                            "title",
                            "contributors",
                            "subjects",
                            "imageUrls",
                            "source",
                            "fetchedAt",
                            "attributes"
                          ],
                          "type": "object"
                        }
                      },
                      "required": ["outcome", "product"],
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "outcome": {
                          "enum": ["not_found"],
                          "type": "string"
                        }
                      },
                      "required": ["outcome"],
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "outcome": {
                          "enum": ["unavailable"],
                          "type": "string"
                        }
                      },
                      "required": ["outcome"],
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "200"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"],
                  "type": "object"
                }
              }
            },
            "description": "400"
          }
        },
        "summary": "Look up a normalised ISBN product",
        "tags": ["lookup"]
      }
    }
  }
}
