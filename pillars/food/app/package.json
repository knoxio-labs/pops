{
  "name": "@pops/app-food",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm run build:remote",
    "build:remote": "tsx scripts/build-remote.ts",
    "typecheck": "node ../../../scripts/require-built-graph.mjs && tsc --noEmit",
    "test": "node ../../../scripts/require-built-graph.mjs && vitest run",
    "test:coverage": "node ../../../scripts/require-built-graph.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "generate:food-client": "openapi-ts && oxfmt --write src/food-api",
    "generate:lists-client": "openapi-ts -f openapi-ts.lists.config.ts && oxfmt --write src/lists-api"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hey-api/client-fetch": "^0.13.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.10",
    "@pops/food": "workspace:*",
    "@pops/navigation": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.2",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@lezer/common": "^1.5.3",
    "@lezer/generator": "^1.8.1",
    "@pops/lists": "workspace:*",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "better-sqlite3": "^13.0.3",
    "jsdom": "^30.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
