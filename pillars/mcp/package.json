{
  "name": "@pops/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "node ../../scripts/require-built-graph.mjs && tsc --noEmit",
    "test": "node ../../scripts/require-built-graph.mjs && vitest run",
    "test:live-seam": "node ../../scripts/require-built-graph.mjs && vitest run --config vitest.live-seam.config.ts",
    "test:acceptance": "node ../../scripts/require-built-graph.mjs && vitest run --config vitest.acceptance.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pops/pillar-sdk": "workspace:*",
    "dotenv": "^18.0.3",
    "express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.2"
  }
}
