{
  "name": "@pops/app-bfm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm run build:remote",
    "build:remote": "tsx scripts/build-remote.ts",
    "typecheck": "node ../../../scripts/require-built-graph.mjs && tsc --noEmit",
    "test": "node ../../../scripts/require-built-graph.mjs && vitest run",
    "test:coverage": "node ../../../scripts/require-built-graph.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "generate:api": "openapi-ts -o src/bfm-api"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@pops/bfm": "workspace:*",
    "@pops/navigation": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.13",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.11"
  }
}
