{
  "name": "@pops/app-bfm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm run build:remote",
    "build:remote": "tsx scripts/build-remote.ts",
    "typecheck": "node ../../../scripts/require-built-graph.mjs && tsc --noEmit",
    "test": "node ../../../scripts/require-built-graph.mjs && vitest run",
    "test:coverage": "node ../../../scripts/require-built-graph.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "generate:api": "openapi-ts -o src/bfm-api"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@pops/bfm": "workspace:*",
    "@pops/navigation": "workspace:*",
    "@pops/pillar-sdk": "workspace:*",
    "@pops/types": "workspace:*",
    "@pops/ui": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "i18next": "^26.5.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
