{
  "info": {
    "description": "OpenAPI projection of the bfm pillar's REST contract. Authored as a ts-rest contract (src/contract/rest.ts); consumed by the mobile client and by the pillar SDK to build its operationId route map.",
    "title": "@pops/bfm",
    "version": "0.1.0"
  },
  "openapi": "3.0.2",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
