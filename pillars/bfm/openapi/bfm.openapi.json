    "/health": {
      "get": {
        "operationId": "health",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "ok": {
                      "enum": [true],
                      "type": "boolean"
                    },
                    "pillar": {
                      "enum": ["bfm"],
                      "type": "string"
                    },
                    "status": {
                      "enum": ["ok"],
                      "type": "string"
                    },
                    "ts": {
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": ["ok", "status", "pillar", "version", "ts"],
                  "type": "object"
                }
              }
            },
            "description": "200"
          }
        },
        "summary": "Liveness shape. Answers without a database round-trip",
        "tags": []
      }
    },
