# Dependencies
node_modules/
package-lock.json

# Build output
dist/
# Bundled nginx render + watcher CLIs (pillars/shell, built in-image)
dist-scripts/
# tsc -b project-reference incremental build state
*.tsbuildinfo
# Local turbo cache (never committed; turbo is not the orchestrator — mise is)
.turbo/

# Rust build output (repo-root cargo workspace; members under pillars/ + libs/).
# Cargo.lock IS committed for the workspace (reproducible bin builds).
target/

# Xcode + SwiftPM output (clients/, ADR-043). The .xcodeproj is generated from
# project.yml by XcodeGen and never committed: a pbxproj is a generated XML blob
# that conflicts on every parallel branch and that no tool here can edit safely.
clients/**/*.xcodeproj
.build/
DerivedData/
# Where `mise run build:for-testing` puts the one shared iOS-Simulator compile
# and its compiler log. Dot-prefixed on purpose — the guards under scripts/ walk
# the repo tree and skip dot-directories, so a gigabyte of build output here is
# invisible to them without each one needing a new skip-list entry.
clients/*/.derived-data/
*.xcuserstate
.swiftpm/
# Points the committed signing xcconfig at this machine's Apple team. Written by
# `mise run generate`; never committed, because the path in it is machine-local.
clients/**/Config/Signing.local.xcconfig

# Environment and secrets
.env
.env.*
!.env.example
*.secret

# Data files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
# SQLite WAL-mode auxiliary files for extensionless databases
*-wal
*-shm
*.csv
entity_lookup.json
ai_entity_cache.json

# OS
.DS_Store

# IDE
.vscode/
.idea/
.obsidian/
.claude/

# Logs
*.log
*.jsonl

# Ansible
*.retry
.ansible/

# Mise
.mise/
# Per-machine overrides of a committed mise.toml, which is how a developer
# points a task at different local state — a simulator this laptop actually has,
# say — without editing the pin every clone and every CI run shares. It takes
# precedence over the committed file, so committing one would silently redirect
# everybody else's runs. Every spelling mise itself treats as "local" is listed
# here (not just the two that happened to exist already), so
# check-mise-tool-overrides.mjs can treat "gitignored" as the actual exclusion
# test rather than "named .local." — see that script's file header.
#
# Three of these six contain a slash before the final segment. Git anchors a
# pattern with a mid-pattern slash to this .gitignore's own directory (the
# repo root) rather than matching at any depth, so without the `**/` prefix a
# pillars/<id>/mise/config.local.toml would NOT actually be excluded despite
# looking like the same "local" spelling as the other three. The `**/` prefix
# makes all six match uniformly regardless of nesting.
mise.local.toml
.mise.local.toml
**/mise/config.local.toml
.config/mise.local.toml
**/.config/mise/config.local.toml
**/.config/mise/mise.local.toml
# The same six spellings again, but for a per-environment config (mise inserts
# the environment immediately before ".local.toml", e.g. `mise.local.toml` ->
# `mise.ci.local.toml` — not `mise.local.ci.toml`). The `*` matches any
# environment name, not just `ci` (the only one this repo's workflows set
# today, per discoverMiseEnvValues in check-mise-tool-overrides.mjs), so a
# future workflow adding a new MISE_ENV value doesn't reopen this gap. Same
# `**/` anchoring fix as above applies to the same three slash-containing
# spellings.
mise.*.local.toml
.mise.*.local.toml
**/mise/config.*.local.toml
.config/mise.*.local.toml
**/.config/mise/config.*.local.toml
**/.config/mise/mise.*.local.toml

*storybook.log
storybook-static

# Test artifacts
playwright-report/
test-results/
coverage/
# Per-project module-registry snapshots emitted by the install-set
# switching harness (PRD-101 US-11 follow-up). Regenerated on every
# Playwright run; never committed.
pillars/shell/.e2e/

# Temporary files
tmp/

.room-sandbox/
.room-agent.json
data/
!pillars/**/src/**/data/
!pillars/**/src/**/data/**
!libs/**/src/**/data/
!libs/**/src/**/data/**
secrets
