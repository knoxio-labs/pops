# Husky runs this under `sh -e`, so an unguarded failing command aborts the push.
#
# The typecheck is scoped to what the push contains rather than run
# unconditionally: it is `tsc -b` over the whole compiled graph plus a fan-out
# to 24 units, one of which runs `cargo check`, and a branch that touches only
# `clients/ios` (in neither workspace — ADR-043) cannot affect any of it.
# scripts/pre-push-scope.mjs decides, and prints two verdicts (one per line):
# the compiled-graph decision, then whether this push touches scripts/ — a
# tree `tsc -b tsconfig.build.json` and the compiled-graph fan-out never reach
# (see mise.toml's `[tasks."typecheck:scripts"]` comment). Both default to
# `run` on any doubt; the `|| output=...` below keeps that true even if node
# itself cannot start.
output=$(node scripts/pre-push-scope.mjs) || output="run
run"
decision=$(printf '%s\n' "$output" | sed -n '1p')
scripts_decision=$(printf '%s\n' "$output" | sed -n '2p')
[ -n "$decision" ] || decision=run
[ -n "$scripts_decision" ] || scripts_decision=run

if [ "$decision" = skip ]; then
  echo "pre-push: nothing in this push reaches the pnpm/cargo workspace — typecheck skipped."
else
  # Checked here rather than left to `tsc`, which reports a stale install as a
  # missing module in whichever package imports it first — a file the author has
  # usually never opened, with a message that reads like their mistake.
  if [ ! -d node_modules ]; then
    echo "pre-push: node_modules is missing. Run 'pnpm install --frozen-lockfile' and push again." >&2
    exit 1
  fi
  if [ pnpm-lock.yaml -nt node_modules/.modules.yaml ]; then
    echo "pre-push: pnpm-lock.yaml is newer than your last install. If the typecheck"
    echo "          below fails on a module you did not touch, that is why —"
    echo "          run 'pnpm install --frozen-lockfile' and push again."
  fi
  pnpm typecheck

  if [ "$scripts_decision" = run ]; then
    # `mise run typecheck` never reaches scripts/ (no mise.toml there for the
    # run-all fan-out, and tsconfig.build.json's `references` stop at libs/*
    # and pillars/*), but quality.yml's scripts-tests job gates it in CI
    # regardless — run the same two tasks here so a scripts/-touching push
    # can't pass locally and still fail there.
    mise run test:scripts
    mise run typecheck:scripts
  fi
fi

branch=$(git branch --show-current)

[ "$branch" = "main" ] && exit 0

git fetch origin main --quiet
if ! git merge-tree --write-tree origin/main HEAD > /dev/null 2>&1; then
  echo "pre-push: branch '$branch' conflicts with origin/main — rebase before pushing."
  exit 1
fi

# Projects every linted file this push touches onto origin/main's current
# tip and fails if the projection crosses the oxlint `max-lines` cap — the
# rebase-tips-a-shared-file-over-budget failure mode that no other local
# gate sees, because lint-staged only lints staged files and this cares
# about files the push touches that this commit did not stage.
node scripts/ci/check-line-budget-headroom.mjs --base main
