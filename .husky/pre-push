# Husky runs this under `sh -e`, so an unguarded failing command aborts the push.
#
# stdin (the pre-push ref list) is captured once here because two separate
# node invocations below each need to read it and a pipe can only be read once.
refs_input=$(cat)

# No commit on the branch may credit an AI assistant (POPS-3430). The
# commit-msg hook stops most at commit time; this catches the rest, such as a
# commit made before `pnpm install` installed the hooks, which still lands on
# main when the PR squash-merges. It runs first because it takes a second and
# the typecheck below does not. Skipped only when there is no origin/main to
# take the range from; CI checks the same range anyway.
if git rev-parse --verify --quiet origin/main >/dev/null; then
  node scripts/ci/check-commit-attribution.mjs --base origin/main
fi

# Scope remains conservative when the pushed refs cannot be resolved.
output=$(printf '%s' "$refs_input" | node scripts/pre-push-scope.mjs) || output="run
run"
decision=$(printf '%s\n' "$output" | sed -n '1p')
scripts_decision=$(printf '%s\n' "$output" | sed -n '2p')
[ -n "$decision" ] || decision=run
[ -n "$scripts_decision" ] || scripts_decision=run

without_repo_locating_git_env() {
  # Git and Husky inject helper paths before invoking hooks. Restore the
  # caller's path so identical manual and hook checks can share evidence.
  validation_task_path=${PATH#node_modules/.bin:}
  if [ -n "${GIT_EXEC_PATH:-}" ]; then
    validation_task_path=${validation_task_path#"$GIT_EXEC_PATH":}
  fi
  env \
    -u GIT_DIR \
    -u GIT_WORK_TREE \
    -u GIT_INDEX_FILE \
    -u GIT_COMMON_DIR \
    -u GIT_OBJECT_DIRECTORY \
    -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
    -u GIT_PREFIX \
    -u GIT_QUARANTINE_PATH \
    -u GIT_NAMESPACE \
    -u GIT_EXEC_PATH \
    PATH="$validation_task_path" \
    "$@"
}

if [ "$decision" = skip ]; then
  echo "pre-push: nothing in this push reaches the pnpm/cargo workspace — typecheck skipped."
else
  # Checked here rather than left to `tsc`, which reports a stale install as a
  # missing module in whichever package imports it first — a file the author has
  # usually never opened, with a message that reads like their mistake.
  if [ ! -d node_modules ]; then
    echo "pre-push: node_modules is missing. Run 'pnpm install --frozen-lockfile' and push again." >&2
    exit 1
  fi
  if [ pnpm-lock.yaml -nt node_modules/.modules.yaml ]; then
    echo "pre-push: pnpm-lock.yaml is newer than your last install. If the typecheck"
    echo "          below fails on a module you did not touch, that is why —"
    echo "          run 'pnpm install --frozen-lockfile' and push again."
  fi
  # A stale lockfile is invisible to every other local gate. `pnpm typecheck`,
  # `mise run test`, `mise run lint` and `pnpm format:check` all read
  # `node_modules`, which still holds the resolution from the last install — so
  # a tree that cannot be installed from scratch passes all of them. CI installs
  # from scratch and fails in every job that installs: one such lockfile on
  # POPS-3221 reported as 75 red checks, and the cause named in none of them.
  #
  # `--lockfile-only` resolves against the manifests without touching
  # `node_modules`, so this costs ~0.3s on a clean tree. It catches both
  # directions — a dependency added to a package.json and never installed, and
  # one removed while the lockfile still carries it.
  if ! lockfile_reason=$(without_repo_locating_git_env pnpm install --frozen-lockfile --lockfile-only 2>&1); then
    echo "pre-push: pnpm-lock.yaml does not match the package.json files in this push." >&2
    echo "          Run 'pnpm install' and commit the updated lockfile." >&2
    printf '%s\n' "$lockfile_reason" >&2
    exit 1
  fi

  if ! git diff --quiet HEAD -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "pre-push: commit or move aside tracked changes and untracked source before validating the pushed tree." >&2
    exit 1
  fi
  without_repo_locating_git_env mise run check -- --typecheck-only

  if [ "$scripts_decision" = run ]; then
    without_repo_locating_git_env mise run test:scripts
  fi
  if ! git diff --quiet HEAD -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "pre-push: validation generated changes outside HEAD; review and commit them before pushing." >&2
    exit 1
  fi
fi

# Unlike the typecheck above, the conflict check (`git merge-tree`) and the
# line-budget projection read git objects directly, so they can run against
# whatever commit is actually being pushed rather than the worktree's HEAD.
# scripts/pre-push-check-refs.mjs decides that, ref by ref.
printf '%s' "$refs_input" | node scripts/pre-push-check-refs.mjs
