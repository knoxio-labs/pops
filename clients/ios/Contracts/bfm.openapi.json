                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["code", "message"],
                  "type": "object"
                }
              }
            },
            "description": "400"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": ["rate_limited"],
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "retryAfterSeconds": {
                      "exclusiveMinimum": true,
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
