            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "expiresIn": {
                      "exclusiveMinimum": true,
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
