            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": ["pairing_rejected"],
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["code", "message"],
                  "type": "object"
                }
              }
            },
            "description": "403"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": ["rate_limited"],
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "retryAfterSeconds": {
