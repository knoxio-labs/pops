<?xml version="1.0" encoding="UTF-8"?>
<!--
	Everything Xcode can synthesise is left to GENERATE_INFOPLIST_FILE, which
	merges its keys on top of this file. Only keys the generator refuses to carry
	belong here: an INFOPLIST_KEY_ build setting for a key outside Xcode's
	allowlist is dropped silently, with no warning and no key in the built plist.

	POPS_BFM_BASE_URL is per-configuration and defined in project.yml. Release
	defines it empty on purpose: a shipped binary carries no hostname, and the
	base URL it uses arrives with the pairing QR instead.

	CFBundleURLTypes has no INFOPLIST_KEY_ equivalent at all — there is no
	build setting for an array of dictionaries — so the `pops` URL scheme can
	only be declared here. A label's soft reference
	(`pops://<pillar>/<type>/<id>`) opens through this scheme and resolves via
	`onOpenURL` the same way the QR scanner resolves it, through
	`AppCore`'s `EntityRouter`.

	BGTaskSchedulerPermittedIdentifiers and UIBackgroundModes are arrays with
	no INFOPLIST_KEY_ equivalent either. The identifier is
	`BackgroundRefresh.inventoryIdentifier` in AppCore: a request for one not
	listed here is refused, and `fetch` is what lets the system grant an app
	refresh task at all.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>POPSBFMBaseURL</key>
	<string>$(POPS_BFM_BASE_URL)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.knoxiolabs.pops</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pops</string>
			</array>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.knoxiolabs.pops.inventory.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
